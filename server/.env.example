# Documentation only: export selected variables or manually add them to the root .env later.
# scripts/run_server.py loads root .env safely; the Swift binary itself reads only its environment.
# The repository root .env intentionally remains exactly empty.
REVA_STORAGE=local
REVA_HOST=127.0.0.1
REVA_PORT=8080
REVA_DATA_DIRECTORY=.local-data

# Accounts: email/password sign-up and log-in with bcrypt hashes and hashed session tokens.
# REVA_ACCOUNTS=enabled            # disabled removes /v1/auth/* and accepts static tokens only
# REVA_SIGNUP=open                 # closed keeps log-in working but answers sign-up with 403
# REVA_SESSION_DAYS=30             # 1-365
# Exact browser origins allowed for CORS (never *): https://…, or http://127.0.0.1|localhost[:port].
# REVA_ALLOWED_ORIGINS=https://your-web-domain.example,http://localhost:5173

# PostgreSQL requires REVA_STORAGE=postgres and DATABASE_URL. Static REVA_TOKENS is optional when
# accounts are enabled; PostgreSQL or a non-loopback listener needs REVA_TOKENS or REVA_ACCOUNTS=enabled.
# Replace placeholders yourself; never commit actual credentials.
# REVA_TOKENS='{"replace-with-a-random-token-at-least-24-characters":"your-owner-id"}'
# DATABASE_URL='postgres://user:password@your-tiger-host:5432/reva?sslmode=verify-full'

# Only for a separately provisioned loopback PostgreSQL test server with sslmode=disable:
# REVA_ALLOW_INSECURE_LOCAL_POSTGRES=true
# REVA_TEST_DATABASE_URL='postgres://test-user:test-password@127.0.0.1:5432/reva_test?sslmode=disable'

# Optional summary/transcription adapters; private tokens or account-only server mode enable paid access.
# GEMINI_API_KEY=replace-with-your-google-ai-studio-key
# GEMINI_MODEL=gemini-flash-latest
# All Gemini analysis starts on the moving Flash alias; transient failures immediately try gemini-flash-lite-latest.
# Empty values and prior gemini-3.8-flash / gemini-3.5-flash-lite / gemini-flash-lite-latest settings migrate to Flash.
# Other explicit model overrides remain primary-only overrides; the Lite fallback stays fixed.
# OPENAI_API_KEY=replace-with-your-openai-key
# OPENAI_TRANSCRIPTION_MODEL=whisper-1
# Optional live browser captions. The server mints a one-use Scribe session; this key stays private.
# ELEVENLABS_API_KEY=replace-with-your-speech-to-text-enabled-key
