{
  "name": "reva-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "assets": "node scripts/prepare-assets.mjs",
    "predev": "npm run assets",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "npm run assets",
    "build": "tsc -b && vite build",
    "serve": "node scripts/serve.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run src",
    "format": "prettier --write src scripts vite.config.ts",
    "format:check": "prettier --check src scripts vite.config.ts"
  },
  "dependencies": {
    "lucide-react": "1.45.0",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.6",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "^5.0.0"
  }
}
